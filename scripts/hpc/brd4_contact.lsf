#!/bin/bash
# A pilot prepares context; a long run replays that authenticated context.
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || exit 2
release=$1
parent=$2
manifest_sha=$3
config=$4
fixture=$5
prepared=${6:-}
prepared_sha=${7:-}
assessment=${8:-}
assessment_sha=${9:-}
project=/work3/s234818/mosaic
python="$project/envs/protenix-tiny/bin/python"
module load python3/3.12.11 cuda/12.9.1 cudnn/v9.13.0.50-prod-cuda-12.X
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$release/scripts/verify_stage0_release.py" "$release" "$manifest_sha"
minimum_free=5
if [[ -n "$prepared" ]]; then
  echo "$assessment_sha  $assessment" | sha256sum -c -
  # This small metadata gate also binds the prepared summary and final config.
  minimum_free=$("$python" "$release/scripts/validate_brd4_launch.py" \
    --assessment "$assessment" --pilot-sha256 "$prepared_sha" --config "$release/$config")
fi
"$python" "$release/scripts/hpc/zhome_quota_preflight.py" --run-dir "$run" --minimum-free-gib "$minimum_free"
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export PYTHONPATH="$release/src:$release/tests" PYTHONDONTWRITEBYTECODE=1
export MOSAIC_CACHE_DIR="$project/cache/mosaic" HF_HOME="$project/cache/huggingface"
export XDG_CACHE_HOME="$project/cache/xdg" TMPDIR="$run/tmp"
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false
mkdir "$TMPDIR"
cd "$release"
hostname > "$run/host.txt"
module list 2> "$run/modules.txt"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv > "$run/gpu.txt"
arguments=()
if [[ -n "$prepared" ]]; then
  arguments+=(--prepared-study "$prepared" --prepared-summary-sha256 "$prepared_sha" --allow-update-count-change)
fi
"$python" examples/protenix_relaxed_gradients.py --config "$config" \
  --fixture-override "$fixture" "${arguments[@]}" \
  --cache-dir "$MOSAIC_CACHE_DIR/protenix" --output "$run/study" > "$run/native.log" 2>&1
