#!/bin/bash
set -euo pipefail
[[ $# == 9 && -n "${LSB_JOBID:-}" ]]
launcher=$1
launcher_manifest=$2
profile=$3
source=$4
root=$5
manifest=$6
control=$7
phase=$8
parent=$9
module load python3/3.12.11
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
"$python" - "$launcher" "$launcher_manifest" "$source" "$manifest" "$profile" <<'MOSAIC_AUTH'
import hashlib,json,sys
from pathlib import Path
pins={'boltz30k':'c214bccf2c94ac6829996bc0ca7d6415d3c19549be4fe7f874cba2b433901cc6',
      'dbmol10k':'600ecc3b33135141a57c029a28a2c72f29e788e3ecf5cb2dac1761146d1d6eed'}
assert pins[sys.argv[5]]==sys.argv[4]
for root,expected in [(Path(sys.argv[1]),sys.argv[2]),(Path(sys.argv[3]),sys.argv[4])]:
 raw=(root/'source_manifest.json').read_bytes();assert hashlib.sha256(raw).hexdigest()==expected
 data=json.loads(raw);assert data['git_revision_reference']=='c74c659344123937608077e3e4078f75f09cd743'
 files=data['files'];assert files
 actual={p.relative_to(root).as_posix() for p in root.rglob('*') if p.is_file() or p.is_symlink()}
 assert actual==set(files)|{'source_manifest.json'}
 for p in [root,*root.rglob('*')]:assert not p.is_symlink() and (p.is_file() or p.is_dir()) and not(p.stat().st_mode&0o222)
 for name,digest in files.items():
  p=root/name;assert not Path(name).is_absolute() and '..' not in Path(name).parts and p.resolve().is_relative_to(root.resolve())
  with p.open('rb') as f:assert hashlib.file_digest(f,'sha256').hexdigest()==digest
MOSAIC_AUTH
export PYTHONPATH="$launcher/scripts:$source/scripts:$source/src:$source/tests"
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export JAX_PLATFORMS=cpu HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
if [[ "$profile" == dbmol10k ]]; then export JAX_ENABLE_X64=1; else export JAX_ENABLE_X64=0; fi
if [[ "$phase" == native || "$phase" == segment ]]; then
  [[ "$LSB_QUEUE" == gpul40s ]]
  module load cuda/12.9.1 cudnn/v9.13.0.50-prod-cuda-12.X
else
  [[ "$LSB_QUEUE" == hpc ]]
  export CUDA_VISIBLE_DEVICES=''
fi
source "$source/scripts/hpc/boltz_node_tmpdir.sh"
cd "$source"
"$python" "$launcher/scripts/adoption_ops.py" --profile "$profile" --launcher "$launcher" --launcher-manifest "$launcher_manifest" --source "$source" --root "$root" --manifest "$manifest" --control "$control" --phase "$phase" --parent "$parent"
