#!/bin/bash
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]]
release=$1
parent=$2
manifest=$3
ready=$4
cpu=$5
assessment_sha=$6
arm=$7
[[ "$arm" == mix50 || "$arm" == random ]]
module load python3/3.12.11 cuda/12.9.1
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
native=/work3/s234818/latentmol/env/boltz311/bin/python
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$release/scripts/verify_stage0_release.py" "$release" "$manifest"
"$python" "$release/scripts/hpc/zhome_quota_preflight.py" --run-dir "$run" --minimum-free-gib 8
echo "$assessment_sha  $ready/assessment.json" | sha256sum -c -
export PYTHONPATH="$release/src:$release/tests" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export JAX_PLATFORMS=cpu JAX_ENABLE_X64=0 OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
source "$release/scripts/hpc/boltz_node_tmpdir.sh"
printf '%s\n' "$TMPDIR" > "$run/tmpdir.txt"
cd "$release"
"$python" scripts/check_boltz_cpu_proof.py "$cpu" "$manifest"
context_sha=$(sha256sum "$ready/prepared/context.pt" | cut -d' ' -f1)
reference_sha=$(sha256sum "$cpu/composition_reference.json" | cut -d' ' -f1)
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv > "$run/gpu.txt"
"$python" examples/brd4_boltz_affinity.py --mode run --config "examples/configs/brd4_boltz_affinity_${arm}_10000.json" \
  --prepared "$ready/prepared" --context-sha256 "$context_sha" --assessment "$ready/assessment.json" --assessment-sha256 "$assessment_sha" \
  --reference "$cpu/composition_reference.json" --reference-sha256 "$reference_sha" \
  --worker-python "$native" --checkpoint /work3/s234818/latentmol/cache/boltz2/boltz2_aff.ckpt \
  --output "$run/study" > "$run/native.log" 2>&1
