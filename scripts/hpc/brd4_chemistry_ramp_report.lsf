#!/bin/bash
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || exit 2
release=$1
parent=$2
manifest=$3
mix=$4
random=$5
ready=$6
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
module load python3/3.12.11
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$release/scripts/verify_stage0_release.py" "$release" "$manifest"
"$python" "$release/scripts/hpc/zhome_quota_preflight.py" --run-dir "$run" --minimum-free-gib 8
export PYTHONPATH="$release/src:$release/tests" PYTHONDONTWRITEBYTECODE=1 JAX_PLATFORMS=cpu
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
export TMPDIR="$run/tmp" MPLCONFIGDIR="$run/mplcache"
mkdir "$TMPDIR"
cd "$release"
set +e
"$python" scripts/render_chemistry_ramp.py \
  --study "$mix/payload/study" --study "$random/payload/study" \
  --config examples/configs/brd4_chemistry_ramp_mix50_10000.json \
  --config examples/configs/brd4_chemistry_ramp_random_10000.json \
  --output "$run/report" --allow-partial > "$run/render.log" 2>&1
render_exit=$?
set -e
echo "$render_exit" > "$run/render_exit.txt"
"$python" scripts/collect_protenix_evidence.py --storage zhome \
  --run "$mix" --run "$random" --run "$ready" --run "$parent" \
  --output "${parent}.tar.gz" > "$run/packaging.log" 2>&1
exit "$render_exit"
