#!/bin/bash
#BSUB -J mosaic-tiny
#BSUB -q gpua10
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=4GB]"
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -W 00:30
# Compatibility entry point; implementation: experiments/native-inference/protenix-tiny/hpc/protenix_tiny.lsf
_mosaic_compat_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  source "$_mosaic_compat_root/experiments/native-inference/protenix-tiny/hpc/protenix_tiny.lsf"
else
  exec bash -l "$_mosaic_compat_root/experiments/native-inference/protenix-tiny/hpc/protenix_tiny.lsf" "$@"
fi
