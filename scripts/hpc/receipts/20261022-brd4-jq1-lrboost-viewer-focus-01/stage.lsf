#!/bin/bash
# Viewer-only CPU validation/certificate/patch. Original artifacts are read-only.
set -euo pipefail
[[ "${LSB_JOBID:-}" =~ ^[0-9]+$ ]]
release=$1
root=$2
manifest=$3
phase=$4
parent=$5
module load python3/3.12.11
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Independent stdlib authentication runs before any new or external module import.
"$python" - "$release" "$manifest" <<'PY'
import hashlib,json,sys
from pathlib import Path,PurePosixPath
def require(value,message):
 if not value:raise ValueError(message)
def sha(path):
 with path.open('rb') as stream:return hashlib.file_digest(stream,'sha256').hexdigest()
roots=[(Path(sys.argv[1]),sys.argv[2]),
 (Path('/work3/s234818/mosaic/releases/20261022-brd4-jq1-lrboost-analysis-01/source'),'214c19387649a741a7ad42f1e3e027061631993b4ae33425071aba9005fdcbcc'),
 (Path('/work3/s234818/mosaic/releases/20261021-brd4-jq1-25-fixed-lrboost-01/source'),'9605a5295b9fe8dfe29f15410b3a029038ea8a18feb16907f043abd5be13c323')]
for root,pin in roots:
 require(root.resolve()==root and not root.is_symlink(),'Source alias')
 require(sha(root/'source_manifest.json')==pin,'Source manifest changed')
 files=json.loads((root/'source_manifest.json').read_text())['files'];require(files,'Empty source manifest')
 for name,expected in files.items():
  rel=PurePosixPath(name);p=root.joinpath(*rel.parts)
  require(not rel.is_absolute() and '..' not in rel.parts and p.resolve().is_relative_to(root),'Source path escaped')
  require(p.is_file() and not p.is_symlink() and sha(p)==expected,'Source file changed')
 actual=set()
 for p in root.rglob('*'):
  require(not p.is_symlink(),'Source symlink')
  if p.is_file() and '__pycache__' not in p.parts and p.name!='source_manifest.json':actual.add(p.relative_to(root).as_posix())
 require(actual==set(files),'Unmanifested source input')
 print('Authenticated',len(files),'source files:',root,flush=True)
PY
science=/work3/s234818/mosaic/releases/20261021-brd4-jq1-25-fixed-lrboost-01/source
analysis=/work3/s234818/mosaic/releases/20261022-brd4-jq1-lrboost-analysis-01/source
export PYTHONPATH="$release:$analysis/scripts:$analysis/tests:$science/scripts:$science/tests:$science/src"
export CUDA_VISIBLE_DEVICES='' JAX_PLATFORMS=cpu JAX_ENABLE_X64=0
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
source "$science/scripts/hpc/boltz_node_tmpdir.sh"
export MPLCONFIGDIR="$TMPDIR/mplconfig"
cd "$release"
"$python" viewer_focus_ops.py --phase "$phase" --source "$release" --root "$root" --manifest "$manifest" --parent "$parent"
