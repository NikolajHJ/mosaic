#!/bin/bash
#BSUB -J mosaic-stage0
#BSUB -q gpua10
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=8GB]"
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -W 02:00
# Compatibility entry point; implementation: experiments/graph-validation/stage0/hpc/small_molecule_stage0.lsf
_mosaic_compat_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  source "$_mosaic_compat_root/experiments/graph-validation/stage0/hpc/small_molecule_stage0.lsf"
else
  exec bash -l "$_mosaic_compat_root/experiments/graph-validation/stage0/hpc/small_molecule_stage0.lsf" "$@"
fi
