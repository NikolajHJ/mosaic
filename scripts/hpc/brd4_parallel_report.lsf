#!/bin/bash
# Compatibility entry point; implementation: scripts/graph/brd4_parallel_report.lsf
_mosaic_compat_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  source "$_mosaic_compat_root/scripts/graph/brd4_parallel_report.lsf"
else
  exec bash -l "$_mosaic_compat_root/scripts/graph/brd4_parallel_report.lsf" "$@"
fi
