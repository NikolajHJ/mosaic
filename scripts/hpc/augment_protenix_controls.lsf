#!/bin/bash
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || { echo 'Allocated LSF job required' >&2; exit 2; }
release=$1
parent=$2
manifest_sha=$3
report=$4
controls=$5
controls_sha=$6
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
module load python3/3.12.11
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$release/scripts/verify_stage0_release.py" "$release" "$manifest_sha"
"$python" "$release/scripts/hpc/stage0_quota_preflight.py" --run-dir "$run" --storage-pool 6 --minimum-free-gib 4.25
export PYTHONPYCACHEPREFIX="$run/pycache" OMP_NUM_THREADS=1
"$python" "$release/scripts/augment_protenix_hard_controls.py" \
  --report "$report" --controls "$controls" --controls-sha256 "$controls_sha" \
  --output "$run/report" > "$run/augmentation.json"
