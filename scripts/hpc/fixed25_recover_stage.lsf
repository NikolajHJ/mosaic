#!/bin/bash
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]]
tool=$1
manifest=$2
root=$3
arm=$4
cpu_sha=$5
adoption_sha=$6
[[ "$arm" == boltz2 || "$arm" == boltz2_chemistry ]]
science=/work3/s234818/mosaic/releases/20261021-brd4-jq1-25-fixed-02/source
original_launcher=/work3/s234818/mosaic/releases/20261021-brd4-jq1-25-fixed-storage-03/source
module load python3/3.12.11
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
export PYTHONPATH="$tool/scripts:$original_launcher/scripts:$science/scripts:$science/src" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 JAX_ENABLE_X64=0 JAX_PLATFORMS=cpu
"$python" "$tool/scripts/verify_stage0_release.py" "$tool" "$manifest"
"$python" "$tool/scripts/verify_stage0_release.py" "$original_launcher" 9ee7bf1d6bf412acdc37fc83415476dbefdf45db89533571d4a646ee16f33772
"$python" "$tool/scripts/verify_stage0_release.py" "$science" 1e3a8a21e2fa68e24d1c9229238999c42a4a9b44bcc78344e73e188c87d1ee64
module load cuda/12.9.1
source "$science/scripts/hpc/boltz_node_tmpdir.sh"
cd "$science"
"$python" "$tool/scripts/fixed25_recover_ops.py" --phase run --tool-source "$tool" --tool-manifest "$manifest" --root "$root" --arm "$arm" --cpu-certificate-sha256 "$cpu_sha" --adoption-sha256 "$adoption_sha"
