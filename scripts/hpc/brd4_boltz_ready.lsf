#!/bin/bash
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]]
release=$1
parent=$2
manifest=$3
cpu=$4
module load python3/3.12.11 cuda/12.9.1
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
native=/work3/s234818/latentmol/env/boltz311/bin/python
cache=/work3/s234818/latentmol/cache/boltz2
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$release/scripts/verify_stage0_release.py" "$release" "$manifest"
"$python" "$release/scripts/hpc/zhome_quota_preflight.py" --run-dir "$run" --minimum-free-gib 10
export PYTHONPATH="$release/src:$release/tests" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export JAX_PLATFORMS=cpu JAX_ENABLE_X64=0 OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 TMPDIR="$run/tmp"
mkdir "$TMPDIR"
cd "$release"
"$python" scripts/check_boltz_cpu_proof.py "$cpu" "$manifest"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv > "$run/gpu.txt"
"$native" -m mosaic.small_molecule.boltz2.prepare --fixture tests/data/brd4_3mxf/fixture.json \
  --cache "$cache" --output "$run/prepared" > "$run/prepare.log" 2>&1
context_sha=$(sha256sum "$run/prepared/context.pt" | cut -d' ' -f1)
reference_sha=$(sha256sum "$cpu/composition_reference.json" | cut -d' ' -f1)
for arm in mix50 random; do
  "$python" examples/brd4_boltz_affinity.py --mode validate \
    --config "examples/configs/brd4_boltz_affinity_${arm}_10000.json" \
    --prepared "$run/prepared" --context-sha256 "$context_sha" \
    --reference "$cpu/composition_reference.json" --reference-sha256 "$reference_sha" \
    --worker-python "$native" --checkpoint "$cache/boltz2_aff.ckpt" \
    --output "$run/$arm" > "$run/$arm.log" 2>&1
done
"$python" scripts/assess_boltz_native.py --run "$run" --cpu "$cpu" --manifest "$manifest"
