#!/bin/bash
# Compatibility entry point; implementation: experiments/brd4/three-model-25/hpc/campaign25_stage.lsf
_mosaic_compat_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  source "$_mosaic_compat_root/experiments/brd4/three-model-25/hpc/campaign25_stage.lsf"
else
  exec bash -l "$_mosaic_compat_root/experiments/brd4/three-model-25/hpc/campaign25_stage.lsf" "$@"
fi
