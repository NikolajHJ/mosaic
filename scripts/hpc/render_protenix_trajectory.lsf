#!/bin/bash
# Compatibility entry point; implementation: scripts/reporting/render_protenix_trajectory.lsf
_mosaic_compat_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  source "$_mosaic_compat_root/scripts/reporting/render_protenix_trajectory.lsf"
else
  exec bash -l "$_mosaic_compat_root/scripts/reporting/render_protenix_trajectory.lsf" "$@"
fi
