#!/bin/bash
# Presentation-only analysis of an already completed study; no model execution.
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || { echo 'Allocated LSF job required' >&2; exit 2; }
release=$1
parent=$2
study=$3
pool=$4
manifest_sha=$5
additional_study=${6:-}
project=/work3/s234818/mosaic
python="$project/envs/protenix-tiny/bin/python"
module load python3/3.12.11
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$release/scripts/verify_stage0_release.py" "$release" "$manifest_sha"
"$python" "$release/scripts/hpc/stage0_quota_preflight.py" --run-dir "$run" --storage-pool "$pool"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export MPLCONFIGDIR="$run/mplcache" PYTHONPYCACHEPREFIX="$run/pycache" JAX_PLATFORMS=cpu
export TMPDIR="$run/tmp" HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
mkdir "$TMPDIR"
hostname > "$run/host.txt"
module list 2> "$run/modules.txt"
cp "$study/summary.json" "$run/input-summary.json"
sha256sum "$study/summary.json" > "$run/input-summary.sha256"
arguments=(--study "$study")
if [[ -n "$additional_study" ]]; then
  cp "$additional_study/summary.json" "$run/input-summary-2.json"
  sha256sum "$additional_study/summary.json" >> "$run/input-summary.sha256"
  arguments+=(--study "$additional_study")
fi
"$python" "$release/scripts/render_protenix_trajectory.py" \
  "${arguments[@]}" --output "$run/report" > "$run/render.log" 2>&1
sha256sum -c "$run/input-summary.sha256"
