#!/bin/bash
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]]
project=$1
root=$2
mode=$3
index=${4:-1}
if [[ -n "${LSB_JOBINDEX:-}" ]]; then index=$LSB_JOBINDEX; fi
python="$project/.venv/bin/python"
module load python3/3.12.11
export PYTHONPATH="$project/src:$project/tests:$project/scripts"
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 JAX_ENABLE_X64=0
export JAX_PLATFORMS=cpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export TMPDIR="$root/tmp/$LSB_JOBID"
mkdir -p "$TMPDIR"
cd "$project"
if [[ "$mode" == prepare ]]; then
  "$python" examples/brd4_jq1_multistart.py --mode prepare \
    --output "$root/prepared" --cache "$project/cache/protenix" \
    > "$root/prepare.stdout.log" 2> "$root/prepare.stderr.log"
  exit 0
fi
[[ "$mode" == validate || "$mode" == run ]]
module load cuda/12.9.1 cudnn/v9.13.0.50-prod-cuda-12.X
export JAX_PLATFORMS=cuda
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv > "$root/gpu-$LSB_JOBID.txt"
if [[ "$mode" == validate ]]; then
  out="$root/validation-clean"
  steps=10
else
  out="$root/cases/case-$(printf '%02d' "$index")"
  steps=1000
fi
mkdir -p "$(dirname "$out")"
"$python" examples/brd4_jq1_multistart.py --mode "$mode" \
  --prepared "$root/prepared" --output "$out" --case-index "$index" \
  --steps "$steps" --cache "$project/cache/protenix" \
  > "$out.stdout.log" 2> "$out.stderr.log"
