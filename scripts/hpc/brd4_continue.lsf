#!/bin/bash
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || exit 2
release=$1
parent=$2
manifest_sha=$3
plan=$4
plan_sha=$5
study=$6
case_index=${7:-}
project=/work3/s234818/mosaic
python="$project/envs/protenix-tiny/bin/python"
module load python3/3.12.11 cuda/12.9.1 cudnn/v9.13.0.50-prod-cuda-12.X
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$release/scripts/verify_stage0_release.py" "$release" "$manifest_sha"
echo "$plan_sha  $plan" | sha256sum -c -
"$python" "$release/scripts/hpc/zhome_quota_preflight.py" --run-dir "$run" --minimum-free-gib 8
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export PYTHONPATH="$release/src:$release/tests" PYTHONDONTWRITEBYTECODE=1
export MOSAIC_CACHE_DIR="$project/cache/mosaic" HF_HOME="$project/cache/huggingface"
export XDG_CACHE_HOME="$project/cache/xdg" TMPDIR="$run/tmp"
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false
mkdir "$TMPDIR"
cd "$release"
hostname > "$run/host.txt"
module list 2> "$run/modules.txt"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv > "$run/gpu.txt"
arguments=()
if [[ -n "$case_index" ]]; then
  arguments+=(--case-index "$case_index")
fi
"$python" examples/continue_brd4.py --plan "$plan" --plan-sha256 "$plan_sha" \
  --study "$study" "${arguments[@]}" --cache-dir "$MOSAIC_CACHE_DIR/protenix" \
  --output "$run/study" > "$run/native.log" 2>&1
