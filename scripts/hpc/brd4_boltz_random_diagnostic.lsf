#!/bin/bash
# Compatibility entry point; implementation: experiments/brd4/boltz-gradient-diagnostic/hpc/brd4_boltz_random_diagnostic.lsf
_mosaic_compat_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  source "$_mosaic_compat_root/experiments/brd4/boltz-gradient-diagnostic/hpc/brd4_boltz_random_diagnostic.lsf"
else
  exec bash -l "$_mosaic_compat_root/experiments/brd4/boltz-gradient-diagnostic/hpc/brd4_boltz_random_diagnostic.lsf" "$@"
fi
