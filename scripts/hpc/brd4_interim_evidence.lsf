#!/bin/bash
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || exit 2
release=$1
parent=$2
manifest_sha=$3
root=/zhome/95/e/206121/mosaic-runs
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
module load python3/3.12.11
mkdir "$parent/payload"
run="$parent/payload"
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
export PYTHONPATH="$release/src:$release/tests" JAX_PLATFORMS=cpu
export TMPDIR="$run/tmp"
mkdir "$TMPDIR"
"$python" "$release/scripts/verify_stage0_release.py" "$release" "$manifest_sha"
"$python" "$release/scripts/hpc/zhome_quota_preflight.py" --run-dir "$run" --minimum-free-gib 8
cd "$release"
"$python" -m pytest tests/test_small_molecule_evidence_root.py -o addopts= \
  -o cache_dir="$run/pytest-cache" --basetemp "$run/pytest-unit-tmp" \
  --junitxml="$run/unit.xml" > "$run/unit.log" 2>&1
"$python" - "$root/20261017-brd4-interim-report-01/payload/report" "$run" <<'PY'
import hashlib,json,sys
from pathlib import Path
report, output = map(Path,sys.argv[1:])
data=json.loads((report/'analysis_summary.json').read_text())
expected=['29745501','29745502','29745473','29745474','29736988']
assert [s['job_id'] for s in data['input_studies']]==expected
assert len(data['cases'])==5 and all(c['updates']==5000 for c in data['cases'])
assert data['report_scope']['kind']=='interim'
assert data['report_scope']['pending_studies'][0]['job_id']=='29745503'
for key,digest in [('model_digest','8d6926d5390fe682e193089f790ce53aa4011a6d5509ddb452a55db3d89b0ab2'),('context_digest','6747ba18833013da02dbf407d9faefb1adbc8314353b4882a34f99557b96d4f6')]:
    assert data['study_identity'][key+'_before']==data['study_identity'][key+'_after']==digest
files={}
for path in sorted(report.iterdir()):
    if path.is_file():
        with path.open('rb') as reader: digest=hashlib.file_digest(reader,'sha256').hexdigest()
        files[path.name]={'bytes':path.stat().st_size,'sha256':digest}
(output/'rendered_report_receipt.json').write_text(json.dumps({'render_job_id':'29747700','scope':'unchanged saved-only interim report','files':files},indent=2)+'\n')
PY
"$python" scripts/collect_protenix_evidence.py --storage zhome \
  --run "$root/20261017-brd4-chain15-best-primal-01" \
  --run "$root/20261017-brd4-chain30-best-primal-01" \
  --run "$root/20261017-brd4-uniform-best-primal-01" \
  --run "$root/20261017-brd4-noisy-best-primal-01" \
  --run "$root/20261016-brd4-5000-03" \
  --run "$root/20261016-brd4-uniform-5000-01" \
  --run "$root/20261016-brd4-noisy-uniform-5000-01" \
  --run "$root/20261016-brd4-canonical-diffuse-5000-01" \
  --run "$root/20261017-brd4-interim-report-01" \
  --run "$parent" --output "$root/$(basename "$parent").tar.gz" > "$run/packaging.log" 2>&1
