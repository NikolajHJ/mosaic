#!/bin/bash
# Compatibility entry point; implementation: experiments/reporting/brd4-comparison/hpc/brd4_interim_evidence.lsf
_mosaic_compat_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  source "$_mosaic_compat_root/experiments/reporting/brd4-comparison/hpc/brd4_interim_evidence.lsf"
else
  exec bash -l "$_mosaic_compat_root/experiments/reporting/brd4-comparison/hpc/brd4_interim_evidence.lsf" "$@"
fi
