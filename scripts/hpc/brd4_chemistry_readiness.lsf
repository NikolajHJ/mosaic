#!/bin/bash
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || exit 2
release=$1
parent=$2
manifest=$3
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
module load python3/3.12.11
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$release/scripts/verify_stage0_release.py" "$release" "$manifest"
"$python" "$release/scripts/hpc/zhome_quota_preflight.py" --run-dir "$run" --minimum-free-gib 8
export PYTHONPATH="$release/src:$release/tests" PYTHONDONTWRITEBYTECODE=1
export CUDA_VISIBLE_DEVICES='' JAX_PLATFORMS=cpu JAX_ENABLE_X64=0
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
export TMPDIR="$run/tmp" MPLCONFIGDIR="$run/mplcache"
mkdir "$TMPDIR"
cd "$release"
hostname > "$run/host.txt"
"$python" -m pytest tests/test_small_molecule_*.py \
  --ignore=tests/test_small_molecule_chemistry.py --ignore=tests/test_small_molecule_chemistry_report.py \
  -o addopts= -m 'not slow and not small_molecule_model' \
  -o cache_dir="$run/pytest-cache-legacy" --basetemp "$run/pytest-unit-tmp-legacy" \
  --junitxml="$run/legacy-unit.xml" > "$run/legacy-unit.log" 2>&1
/work3/s234818/latentmol/env/boltz311/bin/python scripts/create_chemistry_oracles.py \
  --source "$release/tests/data/chemistry_oracle" \
  --manifest "$release/src/mosaic/small_molecule/chemistry/_reference/source_manifest.json" \
  --output "$run/chemistry_oracles.json" > "$run/oracles.log" 2>&1
export JAX_ENABLE_X64=1 MOSAIC_REQUIRE_CHEMISTRY_ORACLES=1 MOSAIC_CHEMISTRY_ORACLES="$run/chemistry_oracles.json"
"$python" -m pytest tests/test_small_molecule_chemistry.py tests/test_small_molecule_chemistry_report.py \
  -o addopts= --strict-markers -o cache_dir="$run/pytest-cache-new" \
  --basetemp "$run/pytest-unit-tmp-new" --junitxml="$run/chemistry-unit.xml" > "$run/chemistry-unit.log" 2>&1
"$python" scripts/prepare_chemistry_reference.py --config examples/configs/brd4_chemistry_5000.json \
  --output "$run/composition_reference.json" > "$run/reference.log" 2>&1
"$python" scripts/validate_chemistry_readiness.py --config examples/configs/brd4_chemistry_5000.json \
  --run "$run" > "$run/assessment.log" 2>&1
