#!/bin/bash
# Scheduled after the selected native jobs end; never reruns their models.
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || exit 2
release=$1
parent=$2
manifest_sha=$3
canonical_run=${4:-}
root=/zhome/95/e/206121/mosaic-runs
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
module load python3/3.12.11
mkdir "$parent/payload"
run="$parent/payload"
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
export MPLCONFIGDIR="$run/mplcache"
"$python" "$release/scripts/verify_stage0_release.py" "$release" "$manifest_sha"
"$python" "$release/scripts/hpc/zhome_quota_preflight.py" --run-dir "$run" --minimum-free-gib 8
extra_study=()
extra_run=()
if [[ -n "$canonical_run" ]]; then
  [[ "$canonical_run" =~ ^[A-Za-z0-9_-]+$ ]] || exit 2
  extra_study=(--study "$root/$canonical_run/payload/study")
  extra_run=(--run "$root/$canonical_run")
fi
"$python" "$release/scripts/render_protenix_trajectory.py" \
  --study "$root/20261016-brd4-5000-03/payload/study" \
  --study "$root/20261016-brd4-uniform-5000-01/payload/study" \
  --study "$root/20261016-brd4-noisy-uniform-5000-01/payload/study" \
  "${extra_study[@]}" \
  --allow-initialization-comparison --output "$run/report" > "$run/render.log" 2>&1
"$python" "$release/scripts/collect_protenix_evidence.py" --storage zhome \
  --run "$root/20261016-brd4-5000-03" \
  --run "$root/20261016-brd4-uniform-5000-01" \
  --run "$root/20261016-brd4-noisy-uniform-5000-01" \
  "${extra_run[@]}" \
  --run "$run" \
  --output "$root/$(basename "$parent").tar.gz" > "$run/packaging.log" 2>&1
