#!/bin/bash
# Compatibility entry point; implementation: experiments/brd4-jq1/backtracking-25/hpc/jq1_25_interim_stage.lsf
_mosaic_compat_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  source "$_mosaic_compat_root/experiments/brd4-jq1/backtracking-25/hpc/jq1_25_interim_stage.lsf"
else
  exec bash -l "$_mosaic_compat_root/experiments/brd4-jq1/backtracking-25/hpc/jq1_25_interim_stage.lsf" "$@"
fi
