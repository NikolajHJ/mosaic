#!/bin/bash
# Submit with explicit bsub resources; no installation or downloads here.

# Resolve working-source paths; old sealed sources keep their old paths.
_mosaic_layout_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)
mosaic_path() { python3 "$_mosaic_layout_root/scripts/layout/experiment_layout.py" resolve "$1"; }

set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || { echo 'Allocated DTU LSF job required' >&2; exit 2; }
release=$1
parent=$2
pool=$3
manifest_sha=$4
# Optional matched-context replay authenticates a prior prepared study summary.
if [[ -n "${5:-}" ]]; then
  export MOSAIC_GRADIENT_PREPARED_STUDY=$5
  export MOSAIC_GRADIENT_PREPARED_SUMMARY_SHA256=$6
fi
project=/work3/s234818/mosaic
python="$project/envs/protenix-tiny/bin/python"
module load python3/3.12.11 cuda/12.9.1 cudnn/v9.13.0.50-prod-cuda-12.X
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$(mosaic_path "$release/scripts/verify_stage0_release.py")" "$release" "$manifest_sha"
"$python" "$(mosaic_path "$release/scripts/hpc/stage0_quota_preflight.py")" --run-dir "$run" --storage-pool "$pool"
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export PYTHONPATH="$release/src:$release/tests"
export MOSAIC_CACHE_DIR="$project/cache/mosaic" MOSAIC_STAGE0_CACHE="$project/cache/mosaic/protenix"
export HF_HOME="$project/cache/huggingface" XDG_CACHE_HOME="$project/cache/xdg"
export TMPDIR="$run/tmp" PYTHONPYCACHEPREFIX="$run/pycache"
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false MOSAIC_STAGE0_RESULTS="$run/native-results"
mkdir "$TMPDIR"
cd "$release"
hostname > "$run/host.txt"
module list 2> "$run/modules.txt"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv > "$run/gpu.txt"
# Synthetic restart fixtures use two concurrent Python processes. Keep them on
# the allocated CPU cores; an exclusive-process GPU permits only one owner.
JAX_PLATFORMS=cpu "$python" -m pytest tests/test_small_molecule_*.py -o addopts= --strict-markers \
  -m 'not slow and not small_molecule_model' -o cache_dir="$run/pytest-cache" \
  --basetemp "$run/pytest-unit-tmp" --junitxml="$run/unit.xml" > "$run/unit.log" 2>&1
# Independently recheck the exact relaxed-feature expansion on the real GPU;
# the original A10 failure was caused by a TF32 one-hot matrix multiplication.
"$python" -m pytest tests/test_small_molecule_features.py -o addopts= --strict-markers \
  -o cache_dir="$run/pytest-cache" --basetemp "$run/pytest-feature-gpu-tmp" \
  --junitxml="$run/feature-gpu.xml" > "$run/feature-gpu.log" 2>&1
"$python" -m pytest tests/test_small_molecule_contact_native.py -o addopts= --strict-markers \
  -m small_molecule_model -s -o cache_dir="$run/pytest-cache" \
  --basetemp "$run/pytest-native-tmp" --junitxml="$run/native.xml" > "$run/native.log" 2>&1
