#!/bin/bash
# Caller supplies an immutable configuration and optional authenticated pilot.

# Resolve working-source paths; old sealed sources keep their old paths.
_mosaic_layout_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)
mosaic_path() { python3 "$_mosaic_layout_root/scripts/layout/experiment_layout.py" resolve "$1"; }

set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || { echo 'Allocated LSF job required' >&2; exit 2; }
release=$1
parent=$2
pool=$3
manifest_sha=$4
config=$5
fixture=$6
prepared=${7:-}
prepared_sha=${8:-}
project=/work3/s234818/mosaic
python="$project/envs/protenix-tiny/bin/python"
module load python3/3.12.11 cuda/12.9.1 cudnn/v9.13.0.50-prod-cuda-12.X
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$(mosaic_path "$release/scripts/verify_stage0_release.py")" "$release" "$manifest_sha"
# Compact evidence budgets at most 1 GiB new files; retain the 4 GiB reserve.
"$python" "$(mosaic_path "$release/scripts/hpc/stage0_quota_preflight.py")" --run-dir "$run" --storage-pool "$pool" --minimum-free-gib 5
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export PYTHONPATH="$release/src:$release/tests"
export MOSAIC_CACHE_DIR="$project/cache/mosaic" HF_HOME="$project/cache/huggingface"
export XDG_CACHE_HOME="$project/cache/xdg" TMPDIR="$run/tmp" PYTHONPYCACHEPREFIX="$run/pycache"
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 JAX_PLATFORMS=cuda
export XLA_PYTHON_CLIENT_PREALLOCATE=false
mkdir "$TMPDIR"
cd "$release"
hostname > "$run/host.txt"
module list 2> "$run/modules.txt"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv > "$run/gpu.txt"
arguments=()
if [[ -n "$prepared" ]]; then
  arguments+=(--prepared-study "$prepared" --prepared-summary-sha256 "$prepared_sha" --allow-update-count-change)
fi
"$python" "$(mosaic_path examples/protenix_relaxed_gradients.py)" --config "$config" \
  --fixture-override "$fixture" "${arguments[@]}" \
  --cache-dir "$MOSAIC_CACHE_DIR/protenix" --output "$run/study" > "$run/native.log" 2>&1
