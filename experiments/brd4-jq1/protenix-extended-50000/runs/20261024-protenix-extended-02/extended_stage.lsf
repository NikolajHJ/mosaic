#!/bin/bash
set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]]
release=$1
root=$2
manifest=$3
phase=$4
parent=$5
module load python3/3.12.11
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
"$python" "$release/scripts/verify_stage0_release.py" "$release" "$manifest"
export PYTHONPATH="$release/scripts:$release/tests:$release/src" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 JAX_ENABLE_X64=0
if [[ "$phase" == native || "$phase" == segment ]]; then
  [[ "$LSB_QUEUE" == gpul40s ]]
  module load cuda/12.9.1 cudnn/v9.13.0.50-prod-cuda-12.X
  export JAX_PLATFORMS=cuda,cpu XLA_PYTHON_CLIENT_PREALLOCATE=false
else
  [[ "$LSB_QUEUE" == hpc ]]
  export CUDA_VISIBLE_DEVICES='' JAX_PLATFORMS=cpu
fi
source "$release/scripts/hpc/boltz_node_tmpdir.sh"
cd "$release"
"$python" scripts/extended_ops.py --phase "$phase" --root "$root" --source "$release" --manifest "$manifest" --parent "$parent"
