#!/bin/bash
# Read-only capture from live native files. Never runs models or molecular repair.

# Resolve working-source paths; old sealed sources keep their old paths.
_mosaic_layout_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)
mosaic_path() { python3 "$_mosaic_layout_root/scripts/layout/experiment_layout.py" resolve "$1"; }

set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]]
release=$1
root=$2
manifest=$3
parent=$4
module load python3/3.12.11
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
export PYTHONPATH="$release/scripts:$release/src:$release/tests" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export CUDA_VISIBLE_DEVICES='' JAX_PLATFORMS=cpu OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
export MPLCONFIGDIR="$parent/mplcache"
cd "$release"
"$python" "$(mosaic_path scripts/verify_stage0_release.py)" "$release" "$manifest"
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$(mosaic_path scripts/hpc/zhome_quota_preflight.py)" --run-dir "$run" --minimum-free-gib 6
"$python" - "$root" "$manifest" <<'PY'
import sys,xml.etree.ElementTree as ET
from pathlib import Path
from jq1_report_contract import read,require,sha
root,manifest=Path(sys.argv[1]),sys.argv[2]
a=read(root/'cpu/payload/assessment.json')
require(a['status']=='passed' and a['source_manifest_sha256']==manifest,'Wrong report CPU certificate')
for p in a['proofs']: require(sha(p['path'])==p['sha256'],'CPU proof changed')
cases=ET.parse(root/'cpu/payload/report-tests.xml').findall('.//testcase')
require(bool(cases) and not any(c.find(t) is not None for c in cases for t in ('failure','error','skipped')),'Report fixtures failed')
PY
"$python" "$(mosaic_path scripts/render_jq1_25_interim.py)" --output "$run/report" --proofs "$run/native-prefix-proofs" --completions "$root" > "$run/render.log" 2>&1
"$python" - "$root" "$run" "$manifest" <<'PY'
import json,os,shutil,sys
from pathlib import Path
from jq1_report_contract import read,require,sha
root,run,manifest=Path(sys.argv[1]),Path(sys.argv[2]),sys.argv[3]
r=read(run/'report/report_receipt.json')
require(r['complete'] is False and r['input_jobs']==['29770179','29770093','29770124'] and r['n_atoms']==25,'Wrong interim scope')
target=run/'cpu-proof';target.mkdir()
for name in ('assessment.json','report-tests.xml','report-tests.log'):shutil.copyfile(root/'cpu/payload'/name,target/name)
for p in read(root/'cpu/payload/assessment.json')['proofs']:shutil.copyfile(p['path'],target/Path(p['path']).name)
shutil.copyfile('source_manifest.json',run/'report-source-manifest.json')
(run/'assessment.json').write_text(json.dumps({'status':'passed','job_id':os.environ['LSB_JOBID'],'complete':False,
 'report_source_manifest_sha256':manifest,'native_jobs':r['input_jobs'],'included_updates':r['included_updates'],
 'report_receipt_sha256':sha(run/'report/report_receipt.json'),'scope':'Saved-only interim; terminal native checks pending'},indent=2)+'\n')
PY
"$python" "$(mosaic_path scripts/collect_protenix_evidence.py)" --storage zhome --run "$parent" --output "${parent}.tar.gz" > "$run/packaging.log" 2>&1
