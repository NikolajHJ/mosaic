#!/bin/bash
set -euo pipefail
[[ $# == 3 && -n "${LSB_JOBID:-}" ]]
source_root=$1
manifest=$2
phase=$3
module load python3/3.12.11
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 JAX_ENABLE_X64=0
export XLA_PYTHON_CLIENT_PREALLOCATE=false JAX_ENABLE_COMPILATION_CACHE=false
export CUDA_CACHE_DISABLE=1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
if [[ "$phase" == gpu ]]; then
  [[ "$LSB_QUEUE" == gpul40s && "$LSB_DJOB_NUMPROC" == 8 ]]
  module load cuda/12.9.1 cudnn/v9.13.0.50-prod-cuda-12.X
  export JAX_PLATFORMS=cuda,cpu
else
  [[ "$LSB_QUEUE" == hpc ]]
  export CUDA_VISIBLE_DEVICES="" JAX_PLATFORMS=cpu
fi
science_root=/work3/s234818/mosaic/runs/20261022-brd4-jq1-lrboost-analysis-01/protenix-extended-release-03/source
/work3/s234818/mosaic/envs/protenix-tiny/bin/python - "$science_root" <<'PY'
import hashlib,json,sys
from pathlib import Path
source=Path(sys.argv[1]);manifest=source/'source_manifest.json'
assert source.is_dir() and not source.is_symlink() and not manifest.is_symlink()
assert hashlib.sha256(manifest.read_bytes()).hexdigest()=='da9db6821d26b884ca1749303fc8e0b0095bd9ee7cbd1b427cdcf1b22eec6562'
name='scripts/hpc/boltz_node_tmpdir.sh';path=source/name
assert path.is_file() and not path.is_symlink()
assert hashlib.sha256(path.read_bytes()).hexdigest()==json.loads(manifest.read_bytes())['files'][name]
PY
# Retain the original owned short node /tmp creation and EXIT cleanup policy.
source "$science_root/scripts/hpc/boltz_node_tmpdir.sh"
/work3/s234818/mosaic/envs/protenix-tiny/bin/python -u "$source_root/scripts/replay_ops.py" "$manifest" "$phase"
