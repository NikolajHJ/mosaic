#!/bin/bash
# Report-only allocation: verify/test saved presentation, never rerun a model.

# Resolve working-source paths; old sealed sources keep their old paths.
_mosaic_layout_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)
mosaic_path() { python3 "$_mosaic_layout_root/scripts/layout/experiment_layout.py" resolve "$1"; }

set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || exit 2
release=$1
parent=$2
manifest=$3
native=/zhome/95/e/206121/mosaic-runs/20261019-brd4-chemistry-ramp-01-mix50
original=/work3/s234818/mosaic/releases/20261019-brd4-chemistry-ramp-01/source
ready=/zhome/95/e/206121/mosaic-runs/20261019-brd4-chemistry-ramp-01-readiness/payload
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
module load python3/3.12.11
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$(mosaic_path "$release/scripts/verify_stage0_release.py")" "$release" "$manifest"
"$python" "$(mosaic_path "$release/scripts/verify_stage0_release.py")" "$original" dc54acf72b906da9f5e2ceb0f6458314064e48408414496d1717a81117a91c80
"$python" "$(mosaic_path "$release/scripts/hpc/zhome_quota_preflight.py")" --run-dir "$run" --minimum-free-gib 8
export PYTHONPATH="$release/src:$release/tests" PYTHONDONTWRITEBYTECODE=1 JAX_PLATFORMS=cpu
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
export TMPDIR="$run/tmp" MPLCONFIGDIR="$run/mplcache"
mkdir "$TMPDIR"
cd "$release"
bjobs -l 29753667 > "$run/native-job-final.txt"
"$python" - "$original" "$run" "$native" "$ready" <<'PY'
import hashlib,json,shutil,sys
from pathlib import Path
original,run,native,ready=map(Path,sys.argv[1:])
def sha(path):
    with path.open('rb') as stream:return hashlib.file_digest(stream,'sha256').hexdigest()
old=json.loads((original/'source_manifest.json').read_text())['files']
new=json.loads(Path('source_manifest.json').read_text())['files']
assert {k:v for k,v in old.items() if k.startswith(('src/','examples/'))}=={k:v for k,v in new.items() if k.startswith(('src/','examples/'))},'Scientific source/config changed'
study=native/'payload/study'
assert sha(study/'summary.json')=='0236e16f8da2aa333bf469ec5cf07b2fbe962b3a5e4d09a631d90ae60e0dfca8'
assert sha(ready/'assessment.json')=='35dac42a903ee397e77ff06f2b7a35cde5a191a475ebde007f844cc44912a895'
assert 'Done successfully.' in (run/'native-job-final.txt').read_text()
assert 'Successfully completed.' in (native/'stdout.29753667.log').read_text()
proof=run/'native-proof';proof.mkdir()
names=['summary.json','configuration.json','composition_reference.json','initialization.npz',
       'case-0/report.json','pilot/report.json','high_weight_pilot/report.json',
       'native_contact_checks/report.json','coupled_chemistry_probe/preparation.json',
       'coupled_chemistry_probe/derivative_checks/report.json',
       'coupled_chemistry_probe/high_weight_checks/report.json']
for name in names:
    out=proof/name;out.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(study/name,out)
for name in ['assessment.json','legacy-unit.xml','chemistry-unit.xml','composition_reference.json','chemistry_oracles.json']:
    out=run/'readiness-proof'/name;out.parent.mkdir(exist_ok=True);shutil.copyfile(ready/name,out)
shutil.copyfile(native/'stdout.29753667.log',run/'native-stdout.txt')
shutil.copyfile(original/'source_manifest.json',run/'native-source-manifest.json')
shutil.copyfile('source_manifest.json',run/'report-source-manifest.json')
(run/'source-scope.json').write_text(json.dumps({'scientific_source_unchanged':True,'native_job':'29753667','pending_job':'29753668','native_summary_sha256':sha(study/'summary.json')},indent=2))
PY
"$python" -m pytest tests/test_small_molecule_chemistry_ramp_report.py \
  tests/test_small_molecule_chemistry_report.py tests/test_small_molecule_evidence_root.py \
  -o addopts= -o cache_dir="$run/pytest-cache" --basetemp "$run/pytest-unit-tmp" \
  --junitxml="$run/report-tests.xml" > "$run/report-tests.log" 2>&1
"$python" "$(mosaic_path scripts/render_chemistry_ramp.py)" --study "$native/payload/study" \
  --config "$(mosaic_path examples/configs/brd4_chemistry_ramp_mix50_10000.json)" \
  --config "$(mosaic_path examples/configs/brd4_chemistry_ramp_random_10000.json)" \
  --pending-job 29753668 --output "$run/report" > "$run/render.log" 2>&1
"$python" "$(mosaic_path scripts/collect_protenix_evidence.py)" --storage zhome --run "$parent" \
  --output "${parent}.tar.gz" > "$run/packaging.log" 2>&1
