#!/bin/bash

# Resolve working-source paths; old sealed sources keep their old paths.
_mosaic_layout_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)
mosaic_path() { python3 "$_mosaic_layout_root/scripts/layout/experiment_layout.py" resolve "$1"; }

set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]] || exit 2
release=$1
parent=$2
manifest=$3
native=$4
ready=$5
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
module load python3/3.12.11
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$(mosaic_path "$release/scripts/verify_stage0_release.py")" "$release" "$manifest"
"$python" "$(mosaic_path "$release/scripts/hpc/zhome_quota_preflight.py")" --run-dir "$run" --minimum-free-gib 8
export PYTHONPATH="$release/src:$release/tests" PYTHONDONTWRITEBYTECODE=1 JAX_PLATFORMS=cpu
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
export TMPDIR="$run/tmp" MPLCONFIGDIR="$run/mplcache"
mkdir "$TMPDIR"
cd "$release"
# Preserve rendering failures and native partial/failure evidence. A report
# failure cannot change the scientific run outcome or waive its identity gates.
set +e
"$python" "$(mosaic_path scripts/render_chemistry_trajectory.py)" --study "$native/payload/study" \
  --output "$run/report" --allow-partial > "$run/render.log" 2>&1
render_exit=$?
set -e
echo "$render_exit" > "$run/render_exit.txt"
"$python" "$(mosaic_path scripts/collect_protenix_evidence.py)" --storage zhome --run "$native" --run "$ready" \
  --run "$parent" --output "${parent}.tar.gz" > "$run/packaging.log" 2>&1
exit "$render_exit"
