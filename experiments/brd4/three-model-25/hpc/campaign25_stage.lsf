#!/bin/bash
# Normal wrapper arguments avoid LSF splitting inline Python commands.

# Resolve working-source paths; old sealed sources keep their old paths.
_mosaic_layout_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)
mosaic_path() { python3 "$_mosaic_layout_root/scripts/layout/experiment_layout.py" resolve "$1"; }

set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]]
source=$1
root=$2
manifest=$3
phase=$4
arm=$5
parent=$6
producer=$7
module load python3/3.12.11
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
native=/work3/s234818/latentmol/env/boltz311/bin/python
export PYTHONPATH="$source/src:$source/tests:$source/scripts" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 JAX_ENABLE_X64=0
cd "$source"
"$python" "$(mosaic_path scripts/verify_stage0_release.py)" "$source" "$manifest"
if [[ "$phase" == after-cpu || "$phase" == after-prepare || "$phase" == after-ready ]]; then
  params=(--phase "$phase" --source "$source" --root "$root" --manifest "$manifest" --job "$producer")
  [[ "$arm" == none ]] || params+=(--arm "$arm")
  "$python" "$(mosaic_path scripts/campaign25_ops.py)" "${params[@]}"
  exit 0
fi
[[ "$phase" == prepare || "$phase" == validate || "$phase" == run ]]
if [[ "$phase" == run && "$arm" == boltz2_chemistry ]]; then
  echo 'Full chemistry optimization is held for measured runtime review' >&2
  exit 1
fi
module load cuda/12.9.1
export JAX_PLATFORMS=cpu
if [[ "$arm" == protenix ]]; then
  module load cudnn/v9.13.0.50-prod-cuda-12.X
  export JAX_PLATFORMS=cuda XLA_PYTHON_CLIENT_PREALLOCATE=false
fi
source "$(mosaic_path "$source/scripts/hpc/boltz_node_tmpdir.sh")"
mkdir "$parent/payload"
run="$parent/payload"
"$python" "$(mosaic_path scripts/hpc/zhome_quota_preflight.py)" --run-dir "$run" --minimum-free-gib 4
cpu_sha=$("$python" - "$root/dispatch-started.json" <<'PY'
import json,sys
print(json.load(open(sys.argv[1]))['cpu_certificate_sha256'])
PY
)
"$python" - "$root/cpu-certificate.json" "$cpu_sha" "$manifest" <<'PY'
from campaign25_contract import verify_cpu_certificate
import sys
verify_cpu_certificate(*sys.argv[1:])
PY
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv > "$run/gpu.txt"
if [[ "$phase" == prepare ]]; then
  "$native" -m mosaic.small_molecule.boltz2.prepare --fixture tests/data/brd4_3mxf/fixture_25.json \
    --n-atoms 25 --cache /work3/s234818/latentmol/cache/boltz2 --output "$run/prepared" > "$run/prepare.log" 2>&1
  exit 0
fi
config="examples/configs/brd4_25_${arm}_10000.json"
reference="$root/cpu/payload/composition_reference.json"
params=(--mode "$phase" --config "$config" --output "$run/study" --manifest "$manifest" \
  --cpu-certificate "$root/cpu-certificate.json" --cpu-certificate-sha256 "$cpu_sha" --reference "$reference")
if [[ "$arm" != protenix ]]; then
  context_sha=$("$python" - "$root/prepared-certificate.json" "$manifest" <<'PY'
from campaign25_contract import sha
import json,sys
from pathlib import Path
p=Path(sys.argv[1]); a=json.loads(p.read_text())
assert a['status']=='passed' and a['source_manifest_sha256']==sys.argv[2]
for proof in a['proofs']: assert sha(proof['path'])==proof['sha256']
print(a['context_sha256'])
PY
  )
  params+=(--prepared "$root/prepare/payload/prepared" --context-sha256 "$context_sha")
fi
if [[ "$phase" == run ]]; then
  ready="$root/validate-$arm/payload/study/assessment.json"
  ready_sha=$(sha256sum "$ready" | cut -d' ' -f1)
  params+=(--ready "$ready" --ready-sha256 "$ready_sha")
fi
"$python" "$(mosaic_path examples/brd4_25_atoms.py)" "${params[@]}" > "$run/native.log" 2>&1
