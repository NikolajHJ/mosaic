#!/bin/bash

# Resolve working-source paths; old sealed sources keep their old paths.
_mosaic_layout_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)
mosaic_path() { python3 "$_mosaic_layout_root/scripts/layout/experiment_layout.py" resolve "$1"; }

set -euo pipefail
[[ -n "${LSB_JOBID:-}" ]]
launcher=$1
launcher_manifest=$2
launcher_cpu=$3
release=$4
manifest=$5
root=$6
cpu=$7
ready=$8
ready_job=$9
queue=${10}
module load python3/3.12.11
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
python=/work3/s234818/mosaic/envs/protenix-tiny/bin/python
"$python" - "$launcher" "$launcher_manifest" "$launcher_cpu" <<'PY'
import hashlib
import json
from pathlib import Path
import subprocess
import sys

source, expected, cpu = Path(sys.argv[1]), sys.argv[2], Path(sys.argv[3])
assert hashlib.sha256((source / "manifest.json").read_bytes()).hexdigest() == expected
assessment = json.loads((cpu / "assessment.json").read_text())
assert assessment["status"] == "passed"
assert assessment["tests"] == 8
assert all(assessment[key] == 0 for key in ("failures", "errors", "skips"))
assert assessment["launcher_manifest_sha256"] == expected
state = subprocess.run(
    ["bjobs", "-noheader", "-o", "stat", assessment["job_id"]],
    capture_output=True, text=True, check=True,
).stdout.strip()
assert state == "DONE"
for entry in json.loads((source / "manifest.json").read_text())["files"]:
    data = (source / entry["path"]).read_bytes()
    assert len(data) == entry["bytes"]
    assert hashlib.sha256(data).hexdigest() == entry["sha256"]
for proof in assessment["proofs"]:
    assert hashlib.sha256(Path(proof["path"]).read_bytes()).hexdigest() == proof["sha256"]
PY
exec "$python" "$(mosaic_path "$launcher/scripts/submit_boltz_arms.py")" \
  --release "$release" --manifest "$manifest" --root "$root" --cpu "$cpu" \
  --ready "$ready" --ready-job "$ready_job" --queue "$queue"
